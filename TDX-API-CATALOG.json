  "entries": [
    {
      "id": "tdx-auth",
      "purpose": "TDX 取得 Token",
      "method": "POST",
      "url": "https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token",
      "codeReference": "scripts/download.mjs:47",
      "requestShape": "grant_type=client_credentials；client_id/client_secret 只由執行環境提供",
      "fieldsUsedOrExpectedByCode": "access_token",
      "usageBoundary": "只供伺服器端認證，不是交通資料"
    },
    {
      "id": "historical-vd",
      "purpose": "歷史設備與車道方向",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/historical/v2/Historical/Road/Traffic/VD/City/Taipei",
      "codeReference": "scripts/download.mjs:118",
      "requestShape": "Dates=YYYY-MM-DD；$format=JSONL；$top=2000",
      "fieldsUsedOrExpectedByCode": "VDID,TownName,PositionLat,PositionLon,DetectionLinks[LinkID,LaneNum,ActualLaneNum]",
      "usageBoundary": "依同日靜態資料建立測點、方向與車道涵蓋"
    },
    {
      "id": "historical-vd-live",
      "purpose": "歷史逐分鐘車流",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/historical/v2/Historical/Road/Traffic/Live/VD/City/Taipei",
      "codeReference": "scripts/download.mjs:126",
      "requestShape": "Dates=YYYY-MM-DD；$format=JSONL；$top=2000000",
      "fieldsUsedOrExpectedByCode": "VDID,DataCollectTime,Status,LinkFlows[].Lanes[LaneID,Speed,Occupancy,ErrorDiags,Vehicles[VehicleType,Volume]]",
      "usageBoundary": "分車種流量源頭；現有彙整沒有保留完整分車種序列"
    },
    {
      "id": "historical-section-live",
      "purpose": "歷史官方發布路段路況",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/historical/v2/Historical/Road/Traffic/Live/City/Taipei",
      "codeReference": "scripts/download-sections.mjs:59",
      "requestShape": "Dates=YYYY-MM-DD；$format=JSONL；$top=3000000",
      "fieldsUsedOrExpectedByCode": "SectionID,DataCollectTime,TravelSpeed,CongestionLevel",
      "usageBoundary": "與 VD 同時刻分級比對；可能同源，不是獨立政策成效"
    },
    {
      "id": "current-vd",
      "purpose": "目前設備靜態資料",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Traffic/VD/City/Taipei",
      "codeReference": "scripts/live-update.mjs:44",
      "requestShape": "$format=JSON",
      "fieldsUsedOrExpectedByCode": "VDs[].VDID,VDs[].DetectionLinks",
      "usageBoundary": "目前收集程式仍用歷史快照 VD 清單過濾；新設備需重新盤點"
    },
    {
      "id": "current-vd-live",
      "purpose": "目前 VD 分鐘觀測",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Traffic/Live/VD/City/Taipei",
      "codeReference": "scripts/live-update.mjs:44",
      "requestShape": "$format=JSON",
      "fieldsUsedOrExpectedByCode": "VDLives[].VDID,DataCollectTime,LinkFlows[].Lanes[].ErrorType,Vehicles",
      "usageBoundary": "現有程式每分鐘輪詢；ErrorType 轉為 ErrorDiags 供共用篩選"
    },
    {
      "id": "congestion-levels",
