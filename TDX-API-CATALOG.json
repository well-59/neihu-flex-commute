      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Traffic/CongestionLevel/City/Taipei",
      "codeReference": "scripts/reference.mjs:71",
      "requestShape": "$format=JSON",
      "fieldsUsedOrExpectedByCode": "CongestionLevels[CongestionLevelID,MeasureIndex,Levels[Level,LowValue,TopValue]]",
      "usageBoundary": "官方 A–F 門檻；以 E/F 定義壅塞是專案規則"
    },
    {
      "id": "sections",
      "purpose": "官方發布路段對照",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Traffic/Section/City/Taipei",
      "codeReference": "scripts/reference.mjs:72",
      "requestShape": "$format=JSON",
      "fieldsUsedOrExpectedByCode": "Sections[SectionID,SectionName,LinkIDs,RoadDirection,SectionLength]",
      "usageBoundary": "建立 SectionID 與 LinkID 對照，非任意名稱配對"
    },
    {
      "id": "current-section-live",
      "purpose": "官方發布路段目前路況",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Traffic/Live/City/Taipei",
      "codeReference": "scripts/reference.mjs:73",
      "requestShape": "$format=JSON",
      "fieldsUsedOrExpectedByCode": "LiveTraffics[SectionID,TravelSpeed,CongestionLevel,CongestionLevelID,DataCollectTime]",
      "usageBoundary": "reference 腳本取得組別映射；現有 live-update 並未每分鐘取得此端點"
    },
    {
      "id": "link-metadata",
      "purpose": "官方 LinkID 路段資訊",
      "method": "POST",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Link/LinkID",
      "codeReference": "scripts/reference.mjs:69",
      "requestShape": "$format=JSON；JSON body = LinkID 字串陣列",
      "fieldsUsedOrExpectedByCode": "LinkID,RoadName,RoadDirection,RoadClass,StartPoint,EndPoint,Length,Version",
      "usageBoundary": "地圖、方向與路段範圍"
    },
    {
      "id": "link-geometry",
      "purpose": "官方路段 GeoJSON 線形",
      "method": "POST",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Link/Shape/Geometry/GeoJson",
      "codeReference": "scripts/reference.mjs:70",
      "requestShape": "$format=JSON；JSON body = LinkID 字串陣列",
      "fieldsUsedOrExpectedByCode": "features[].properties.LinkID,features[].geometry.coordinates",
      "usageBoundary": "經緯度次序 lon,lat；用 LinkID 映射現有地圖"
    },
    {
      "id": "city-road-links",
      "purpose": "道路名稱查 LinkID 集合",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/basic/v2/Road/Link/CityRoad/Taipei/{roadName}",
      "codeReference": "scripts/reference.mjs:79",
      "requestShape": "$format=JSON；roadName 需 URL encode",
      "fieldsUsedOrExpectedByCode": "LinkID,RoadName,RoadDirection,StartPoint,EndPoint",
      "usageBoundary": "取得園區道路區段，勿只用名稱合併不同方向"
    },
    {
      "id": "address-coordinate",
      "purpose": "官方門牌定位",
      "method": "GET",
      "url": "https://tdx.transportdata.tw/api/advanced/V3/Map/GeoCode/Coordinate/Address/{address}",
      "codeReference": "scripts/reference.mjs:93",
      "requestShape": "$format=JSON；address 需 URL encode",
      "fieldsUsedOrExpectedByCode": "Address,Geometry (POINT)",
      "usageBoundary": "園區門牌或使用者指定目的地；回傳地址仍須核對，不必綁公司"
    },
    {
      "id": "listed-company-profile",
      "purpose": "上市公司基本資料（選用）",
      "method": "GET",
      "url": "https://openapi.twse.com.tw/v1/opendata/t187ap03_L",
      "codeReference": "scripts/reference.mjs:114",
      "requestShape": "無；目前為全部清單後按公司代號篩選",
      "fieldsUsedOrExpectedByCode": "公司代號,住址,出表日期",
      "usageBoundary": "範本公司地址來源，不是交通需求或員工上下班證據"
    }
